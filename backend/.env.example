# AgenticPhishDetector Backend — Environment Variables
# Copy to .env and fill in your values

NVIDIA_API_KEY="your_api_key"
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain, https://cloudflarecustomname.pages.dev
RATE_LIMIT_PER_MINUTE=10
MAX_BODY_LENGTH=50000
MAX_SUBJECT_LENGTH=500
WORKER_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
DEBUG=false